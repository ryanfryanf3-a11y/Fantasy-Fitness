<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the build-generated Info.plist. Registers fantasyfitness:// so
	     Supabase email confirmation links open the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.appteamcarolina.Fantasy-Fitness.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fantasyfitness</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
